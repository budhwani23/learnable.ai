GOOGLE_API_KEY=
REV_AI_API_KEY=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# --- AI explainer video generation (see backend/requirements-video.txt) ---
# Python interpreter that has manim installed (defaults to the backend's own Python)
MANIM_PYTHON=
# Optional overrides
EXPLAINER_MODEL=gemini-3.5-flash
EXPLAINER_TTS_MODEL=gemini-2.5-flash-preview-tts
EXPLAINER_TTS_VOICE=Charon
EXPLAINER_MAX_CONCURRENT=1
EXPLAINER_MAX_QA_PASSES=1
EXPLAINER_FINAL_QUALITY=-qh

# --- Presentations (self-hosted Presenton, see docker-compose.yml) ---
PRESENTON_URL=http://localhost:5001
# Required when Presenton auth is enabled (Admin -> API keys in Presenton's UI)
PRESENTON_API_KEY=
PRESENTATION_MAX_CONCURRENT=2
# Shared secret Presenton uses to call /api/presentations/image-proxy (any long random string)
PRESENTON_IMAGE_PROXY_KEY=
# Slide images: Presenton -> /api/presentations/image-proxy -> NVIDIA FLUX Klein (build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=flux-3-image-klein
NVIDIA_FLUX_STEPS=4
# Use a neutral placeholder when an image fails, so the deck still generates
PRESENTATION_IMAGE_PLACEHOLDER=true

# --- LMS integrations: LTI 1.3 (Moodle, Canvas, Blackboard, Brightspace, Schoology) + Google ---
# Setup: python manage.py migrate && python manage.py lti_setup --base-url https://<public-backend>
# Register each LMS in Django admin (LTI 1.3 tools) or with `lti_setup --register ...`.
FRONTEND_URL=http://localhost:8080
# Public host(s) of this backend, e.g. a cloudflared tunnel or production domain
EXTRA_ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# true when serving over HTTPS so cookies work inside LMS iframes
CROSS_SITE_COOKIES=false
# Google Identity Services web client id (also set VITE_GOOGLE_CLIENT_ID in frontend/.env)
GOOGLE_OAUTH_CLIENT_ID=
